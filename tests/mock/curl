#!/usr/bin/env bash
# Подменный curl для тестов. Отвечает как GitHub, данные берёт из каталогов:
#   MOCK_UPSTREAM        — содержимое репозитория Flowseal (contents API + raw)
#   MOCK_REMOTE_VERSION  — что вернуть на запрос файла VERSION
#   MOCK_TARBALL         — архив, который отдаётся вместо codeload.github.com
# .payload в каталоге макета — ответ на запросы файлов, которых там нет.
# Сбои: файл $MOCK_UPSTREAM/.fail_api — ошибка всех запросов API,
#       .fail_api_lists / .fail_api_bin — ошибка API только для этого каталога,
#       .fail_raw — ошибка загрузки файлов .bin.
out=""; url=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    -H|--max-time|-w) shift 2 ;;
    http*) url="$1"; shift ;;
    *) shift ;;
  esac
done
emit() { if [ -n "$out" ]; then cp "$1" "$out"; else cat "$1"; fi; }
case "$url" in
  */contents/*|*/contents\?*)
    [ -e "${MOCK_UPSTREAM:-/nonexistent}/.fail_api" ] && exit 22
    sub="${url#*/contents}"; sub="${sub%%\?*}"; sub="${sub#/}"
    [ -n "$sub" ] && [ -e "$MOCK_UPSTREAM/.fail_api_$sub" ] && exit 22
    python3 "$(dirname "$0")/listing.py" "$MOCK_UPSTREAM" "$sub" ;;
  http://mock/raw/*)
    rel="$(python3 -c 'import sys,urllib.parse;print(urllib.parse.unquote(sys.argv[1]))' "${url#http://mock/raw/}")"
    case "$rel" in *.bin) [ -e "$MOCK_UPSTREAM/.fail_raw" ] && exit 22 ;; esac
    # файл .payload отдаётся вместо несуществующих (подозрительные имена)
    if [ -f "$MOCK_UPSTREAM/$rel" ]; then emit "$MOCK_UPSTREAM/$rel"
    elif [ -f "$MOCK_UPSTREAM/.payload" ]; then emit "$MOCK_UPSTREAM/.payload"
    else exit 22; fi ;;
  *raw.githubusercontent.com*/VERSION)
    [ -n "${MOCK_REMOTE_VERSION:-}" ] || exit 22
    echo "$MOCK_REMOTE_VERSION" ;;
  *codeload.github.com*)
    [ -f "${MOCK_TARBALL:-}" ] || exit 22
    emit "$MOCK_TARBALL" ;;
  *) exit 6 ;;
esac
